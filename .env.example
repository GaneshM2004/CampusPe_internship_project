# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy this to .env and fill in real values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# --- Groq Cloud (required) ---
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_REAL_KEY

# --- PostgreSQL (used by Docker Compose backend service) ---
DB_PASSWORD=change_me_in_production

# --- JWT signing secret (base64-encoded ≥256-bit key) ---
# Generate with:  openssl rand -base64 32
# Then re-encode: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_SECRET

# --- Frontend → Backend URL (used at Vite build time) ---
VITE_API_URL=http://localhost:8080
